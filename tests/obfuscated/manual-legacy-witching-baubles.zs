import mods.baubles.Baubles;

// double jump on your finger and haste around your neck
Baubles.setSlots(<WitchingGadgets:item.WG_Baubles:0>, ["ring"]);
Baubles.setSlots(<WitchingGadgets:item.WG_Baubles:3>, ["amulet"]);

// sniper zoom from the belt slot
// change the metadata from 6 to 5 for kryptoncaptain 1.2.9
Baubles.setSlots(<WitchingGadgets:item.WG_Baubles:6>, ["belt"]);

// storage cloak on your finger and storage kama around your neck
Baubles.setSlots(<WitchingGadgets:item.WG_Cloak:2>, ["ring"]);
Baubles.setSlots(<WitchingGadgets:item.WG_Kama:2>, ["amulet"]);

// try these one at a time in the charm slot beyond the original four slots
// use the travellers gear ability wheel for storage and the raven glide toggle
Baubles.setSlots(<WitchingGadgets:item.WG_Cloak:4>, ["charm"]);
Baubles.setSlots(<WitchingGadgets:item.WG_Kama:4>, ["charm"]);
Baubles.setSlots(<WitchingGadgets:item.WG_Cloak:3>, ["charm"]);
Baubles.setSlots(<Thaumcraft:FocusPouch>, ["charm"]);
